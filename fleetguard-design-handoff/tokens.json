{
  "colors": {
    "primary": "#0E9B78",
    "primaryDark": "#08765E",
    "darkNavy": "#0D2232",
    "gray700": "#334155",
    "gray400": "#94A3B8",
    "gray100": "#F1F5F9",
    "white": "#FFFFFF",
    "success": "#22C55E",
    "info": "#3882F6",
    "warning": "#A855F7",
    "danger": "#EF4444",
    "accent": "#F59E0B"
  },
  "font": {
    "family": "Plus Jakarta Sans",
    "fallback": "Arial, sans-serif",
    "source": "https://fonts.google.com/specimen/Plus+Jakarta+Sans"
  },
  "typography": {
    "display": {
      "fontSize": 48,
      "lineHeight": 56,
      "fontWeight": "700-800"
    },
    "h1": {
      "fontSize": 40,
      "lineHeight": 48,
      "fontWeight": 700
    },
    "h2": {
      "fontSize": 32,
      "lineHeight": 40,
      "fontWeight": 700
    },
    "h3": {
      "fontSize": 24,
      "lineHeight": 32,
      "fontWeight": "600-700"
    },
    "h4": {
      "fontSize": 20,
      "lineHeight": 28,
      "fontWeight": "600-700"
    },
    "bodyLarge": {
      "fontSize": 16,
      "lineHeight": 26,
      "fontWeight": 400
    },
    "body": {
      "fontSize": 14,
      "lineHeight": 22,
      "fontWeight": 400
    },
    "bodySmall": {
      "fontSize": 12,
      "lineHeight": 18,
      "fontWeight": "400-500"
    },
    "caption": {
      "fontSize": 11,
      "lineHeight": 16,
      "fontWeight": "400-500"
    },
    "button": {
      "fontSize": 14,
      "lineHeight": 20,
      "fontWeight": 600
    }
  },
  "spacing": {
    "space-1": 4,
    "space-2": 8,
    "space-3": 12,
    "space-4": 16,
    "space-6": 24,
    "space-8": 32,
    "space-12": 48,
    "space-20": 80
  },
  "radius": {
    "md": 12,
    "lg": 16,
    "xl": 24
  },
  "shadows": {
    "card": "0 4px 16px rgba(13, 34, 50, 0.06)",
    "dashboard": "0 12px 32px rgba(13, 34, 50, 0.10)"
  },
  "icons": {
    "library": "Lucide",
    "strokeWidthPx": "1.75-2",
    "sizesPx": [
      16,
      20,
      24,
      28,
      32
    ]
  },
  "responsive": {
    "desktop": {
      "hero": 48,
      "h2": 32,
      "featureColumns": 3
    },
    "tablet": {
      "hero": 40,
      "h2": 28,
      "featureColumns": 2
    },
    "mobile": {
      "hero": 32,
      "h2": 24,
      "bodyMin": 14,
      "featureColumns": 1
    }
  }
}